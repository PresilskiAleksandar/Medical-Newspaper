# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5433/medinfo

# Authentication
JWT_SECRET=your_random_secret_here_min_32_chars_long
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# CORS - comma-separated origins allowed (no trailing slash)
# Example: http://localhost:3000,https://medinfo-news.vercel.app
CORS_ORIGIN=http://localhost:3000

# Unsplash API (for image downloads)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
